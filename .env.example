# Railway PostgreSQL injects DATABASE_URL automatically when the database is linked.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"

# Generate a strong random secret before production.
AUTH_SECRET="replace-with-a-long-random-secret"

# Required on Railway / reverse proxies.
AUTH_TRUST_HOST="true"

# Set this to the public Railway domain after the first deployment.
AUTH_URL="https://your-alfa-domain.up.railway.app"

# First admin account created when the users table is empty.
ADMIN_PASSWORD="Alfa@2026"

# Set to "true" on first deploy if you want sample customers and work orders.
SEED_DEMO="false"
