generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }
enum UserRole { ADMIN RECEPTION ACCOUNTING TECHNICIAN STORE }
enum WorkOrderStatus { RECEIVED INSPECTION WAITING_APPROVAL IN_SERVICE READY DELIVERED CANCELLED }
model User { id String @id @default(cuid()) name String username String @unique passwordHash String role UserRole @default(RECEPTION) isActive Boolean @default(true) createdAt DateTime @default(now()) updatedAt DateTime @updatedAt }
model Customer { id String @id @default(cuid()) name String phone String @unique whatsapp String? notes String? vehicles Vehicle[] createdAt DateTime @default(now()) updatedAt DateTime @updatedAt }
model Vehicle { id String @id @default(cuid()) customerId String customer Customer @relation(fields:[customerId],references:[id],onDelete:Cascade) plateNumber String vin String? @unique make String model String year Int? color String? mileage Int? workOrders WorkOrder[] createdAt DateTime @default(now()) updatedAt DateTime @updatedAt @@index([plateNumber]) }
model WorkOrder { id String @id @default(cuid()) orderNumber String @unique vehicleId String vehicle Vehicle @relation(fields:[vehicleId],references:[id]) status WorkOrderStatus @default(RECEIVED) complaint String mileage Int? notes String? createdAt DateTime @default(now()) updatedAt DateTime @updatedAt }
