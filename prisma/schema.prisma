generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  RECEPTION
  ACCOUNTING
  TECHNICIAN
  STORE
}

enum WorkOrderStatus {
  RECEIVED
  INSPECTION
  WAITING_APPROVAL
  IN_SERVICE
  READY
  DELIVERED
  CANCELLED
}

enum ItemKind {
  LABOR
  PART
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIAL
  PAID
  VOID
}

enum QuotationStatus {
  DRAFT
  ISSUED
  ACCEPTED
  EXPIRED
  VOID
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  OTHER
}

model User {
  id           String   @id @default(cuid())
  name         String
  username     String   @unique
  passwordHash String
  role         UserRole @default(RECEPTION)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Customer {
  id         String      @id @default(cuid())
  name       String
  phone      String      @unique
  whatsapp   String?
  notes      String?
  vehicles   Vehicle[]
  workOrders WorkOrder[]
  invoices     Invoice[]
  quotations   Quotation[]
  appointments Appointment[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Vehicle {
  id          String      @id @default(cuid())
  customerId  String
  customer    Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  plateNumber String
  vin         String?     @unique
  make        String
  model       String
  year        Int?
  color       String?
  mileage     Int?
  workOrders  WorkOrder[]
  appointments Appointment[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([plateNumber])
  @@index([customerId])
}

model WorkOrder {
  id           String           @id @default(cuid())
  orderNumber  String           @unique
  customerId   String
  customer     Customer         @relation(fields: [customerId], references: [id])
  vehicleId    String
  vehicle      Vehicle          @relation(fields: [vehicleId], references: [id])
  status       WorkOrderStatus  @default(RECEIVED)
  complaint    String
  mileage      Int?
  notes        String?
  items        WorkOrderItem[]
  inspections  Inspection[]
  invoice      Invoice?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([status])
  @@index([customerId])
  @@index([vehicleId])
}

model WorkOrderItem {
  id          String    @id @default(cuid())
  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  partId      String?
  part        Part?     @relation(fields: [partId], references: [id])
  kind        ItemKind  @default(LABOR)
  description String
  quantity    Float     @default(1)
  unitPrice   Float     @default(0)
  createdAt   DateTime  @default(now())
}

model Inspection {
  id                String    @id @default(cuid())
  workOrderId       String
  workOrder         WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  findings          String
  diagnosis         String?
  recommendations   String?
  estimatedLabor    Float     @default(0)
  estimatedParts    Float     @default(0)
  customerApproved  Boolean?
  approvalNote      String?
  photos            InspectionPhoto[]
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

enum PhotoKind {
  BEFORE
  AFTER
  FINDING
}

model InspectionPhoto {
  id            String     @id @default(cuid())
  inspectionId  String
  inspection    Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  kind          PhotoKind  @default(FINDING)
  url           String
  caption       String?
  isPlaceholder Boolean    @default(true)
  createdAt     DateTime   @default(now())
}

model Invoice {
  id            String        @id @default(cuid())
  invoiceNumber String        @unique
  customerId    String
  customer      Customer      @relation(fields: [customerId], references: [id])
  workOrderId   String?       @unique
  workOrder     WorkOrder?    @relation(fields: [workOrderId], references: [id])
  status        InvoiceStatus @default(DRAFT)
  subtotal      Float         @default(0)
  tax           Float         @default(0)
  total         Float         @default(0)
  notes         String?
  items         InvoiceItem[]
  payments      Payment[]
  issuedAt      DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([customerId])
  @@index([status])
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Float   @default(1)
  unitPrice   Float   @default(0)
}

model Quotation {
  id              String          @id @default(cuid())
  quoteNumber     String          @unique
  customerId      String
  customer        Customer        @relation(fields: [customerId], references: [id])
  beneficiaryName String?
  vehicleMake     String
  vehicleModel    String
  vehicleYear     Int?
  vehicleTrim     String?
  vehicleColor    String?
  vehicleSpecs    String?
  status          QuotationStatus @default(ISSUED)
  subtotal        Float           @default(0)
  tax             Float           @default(0)
  total           Float           @default(0)
  notes           String?
  validUntil      DateTime?
  issuedAt        DateTime        @default(now())
  items           QuotationItem[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([customerId])
  @@index([status])
}

model QuotationItem {
  id          String    @id @default(cuid())
  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  description String
  quantity    Float     @default(1)
  unitPrice   Float     @default(0)
}

model Payment {
  id        String        @id @default(cuid())
  invoiceId String
  invoice   Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount    Float
  method    PaymentMethod @default(CASH)
  notes     String?
  paidAt    DateTime      @default(now())
  createdAt DateTime      @default(now())
}

enum PurchaseStatus {
  DRAFT
  RECEIVED
  CANCELLED
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  DONE
  CANCELLED
  NO_SHOW
}

model WorkshopSettings {
  id           String   @id @default("default")
  workshopName String   @default("مركز ألفا لصيانة السيارات")
  phone        String   @default("")
  address      String   @default("")
  taxPercent   Float    @default(0)
  countryCode  String   @default("962")
  updatedAt    DateTime @updatedAt
}

model Supplier {
  id        String     @id @default(cuid())
  name      String
  phone     String     @unique
  notes     String?
  parts     Part[]
  purchases Purchase[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Part {
  id             String         @id @default(cuid())
  sku            String         @unique
  name           String
  brand          String?
  category       String?
  unit           String         @default("قطعة")
  costPrice      Float          @default(0)
  salePrice      Float          @default(0)
  quantity       Float          @default(0)
  minQuantity    Float          @default(2)
  supplierId     String?
  supplier       Supplier?      @relation(fields: [supplierId], references: [id])
  purchaseItems  PurchaseItem[]
  workOrderItems WorkOrderItem[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model Purchase {
  id          String         @id @default(cuid())
  number      String         @unique
  supplierId  String
  supplier    Supplier       @relation(fields: [supplierId], references: [id])
  status      PurchaseStatus @default(DRAFT)
  total       Float          @default(0)
  notes       String?
  receivedAt  DateTime?
  items       PurchaseItem[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model PurchaseItem {
  id          String   @id @default(cuid())
  purchaseId  String
  purchase    Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  partId      String
  part        Part     @relation(fields: [partId], references: [id])
  quantity    Float
  unitCost    Float
}

model Expense {
  id        String        @id @default(cuid())
  title     String
  category  String
  amount    Float
  method    PaymentMethod @default(CASH)
  notes     String?
  spentAt   DateTime      @default(now())
  createdAt DateTime      @default(now())
}

model Appointment {
  id          String            @id @default(cuid())
  customerId  String
  customer    Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  vehicleId   String?
  vehicle     Vehicle?          @relation(fields: [vehicleId], references: [id])
  scheduledAt DateTime
  status      AppointmentStatus @default(SCHEDULED)
  reason      String
  notes       String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([scheduledAt])
  @@index([status])
}
